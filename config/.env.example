# ============================================
# AI Voice API - 环境配置模板
# 复制为 .env 并修改为实际路径
# ============================================

# ----- GPT-SoVITS (GSVI_v2) -----
# api.py 所在目录的完整路径
GSVI_V2_ROOT=E:/aivoice/GPT-So-VITS/GPT-Sovits/GSVI_v2

# ----- MSST-WebUI -----
# fastapi_preset_api.py 需要放置在 MSST-WebUI 根目录运行
# 或通过此变量指定 MSST-WebUI 根目录
MSST_ROOT=E:/aivoice/MSST-WebUI

# ----- So-VITS-SVC -----
# flask_api.py / flask_api_full_song.py 需要放置在 So-VITS-SVC 根目录
# 或通过此变量指定 So-VITS-SVC 根目录
SVC_ROOT=E:/aivoice/So-VITS-SVC/newpackage/so-vits-svc_tsss/so-vits-svc

# ----- 模型路径 (So-VITS-SVC) -----
SVC_MODEL_PATH=logs/44k/G_55200.pth
SVC_CONFIG_PATH=logs/44k/config.json

# ----- CUDA -----
CUDA_VISIBLE_DEVICES=0

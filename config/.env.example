# ============================================
# AI Voice API - 环境配置模板
# 复制为 .env 后填入实际路径
# 相对路径基于本文件所在目录计算
# ============================================

# ----- GPT-SoVITS (GSVI_v2) -----
# GSVI_v2 项目根目录（api.py 需要 import tools.my_infer）
GSVI_V2_ROOT=../aivoice/GPT-So-VITS/GPT-Sovits/GSVI_v2

# ----- MSST-WebUI -----
# MSST-WebUI 项目根目录
MSST_ROOT=../aivoice/MSST-WebUI

# ----- So-VITS-SVC -----
# So-VITS-SVC 项目根目录
SVC_ROOT=../aivoice/So-VITS-SVC/newpackage/so-vits-svc_tsss/so-vits-svc

# ----- 模型路径 (So-VITS-SVC) -----
# 基于 SVC_ROOT 的相对路径
SVC_MODEL_PATH=logs/44k/G_55200.pth
SVC_CONFIG_PATH=logs/44k/config.json

# ----- CUDA -----
CUDA_VISIBLE_DEVICES=0
